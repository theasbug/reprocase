{
  "name": "reprocase-workspace",
  "version": "1.1.0-beta.5",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx apps/server/src/cli.ts serve --dev",
    "start": "tsx apps/server/src/cli.ts serve",
    "demo": "tsx apps/server/src/cli.ts demo --dev",
    "cli": "tsx apps/server/src/cli.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-web.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "browsers:install": "node scripts/install-browser.mjs",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "electron .",
    "desktop:setup": "node scripts/install-desktop.mjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@fastify/middie": "^9.0.0",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.577.0",
    "openai": "^6.0.0",
    "playwright": "^1.58.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "main": "desktop/main.mjs"
}
